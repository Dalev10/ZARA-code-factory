# Copia este archivo a .env y completa los valores reales antes de correr
# docker compose up. El archivo .env NUNCA se commitea (ver .gitignore).
#
#   cp .env.example .env

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Opcional. Si se omite o se deja vacío, docker-compose.yml usa "validate"
# como valor por defecto.
SPRING_JPA_HIBERNATE_DDL_AUTO=


# Configuración de puertos
POSTGRES_PORT=
API_PORT=

# Secreto de firma de los access token JWT (HS256). Generalo vos mismo,
# nunca reutilices un valor de ejemplo. Al menos 32 bytes/caracteres
# (HS256 lo exige). Por ejemplo, con:
#   openssl rand -base64 48
JWT_SECRET=
